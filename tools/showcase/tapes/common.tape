# Shared look for every NAVIG showcase scene. Included by each tape via `Source common.tape`.
# 1200×700 @ 16px JetBrainsMono Nerd Font ≈ 110 columns — the width navig's tables are designed for.
Set Shell bash
Set FontFamily "JetBrainsMono Nerd Font"
Set FontSize 16
Set Width 1200
Set Height 700
Set Padding 22
Set Margin 0
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set WindowBarSize 36
Set BorderRadius 10
Set TypingSpeed 35ms
Set Framerate 20
Set PlaybackSpeed 1.0
Set CursorBlink false
