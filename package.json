{
  "name": "navig-core-release-tools",
  "private": true,
  "scripts": {
    "version:show": "python tools/version_bump.py show",
    "version:sync": "python tools/_version_sync.py",
    "release:dry": "python tools/version_bump.py bump patch --dry-run",
    "release:normal": "python tools/version_bump.py bump patch --commit --tag --push",
    "release:minor": "python tools/version_bump.py bump minor --commit --tag --push",
    "release:big": "python tools/version_bump.py bump major --commit --tag --push"
  }
}
